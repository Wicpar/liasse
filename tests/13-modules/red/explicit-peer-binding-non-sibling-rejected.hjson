{
  format: 1
  name: explicit-peer-binding-non-sibling-rejected
  suite: scenario
  spec: ["#modules", "§13.3", "§13.5"]
  note: '''
    §13.3: an explicit $use binding names one concrete SIBLING instance and
    exposed interface. §13.5: peer lookup stays within the sibling set, which is
    the module collection being installed into — and a module collection under a
    different containing row is a DIFFERENT collection, by ordinary nesting.

    The install request for "sales" in Acme's collection names `peopleG`, which
    is installed in Globex's. It is not a member of Acme's collection, so the
    explicit binding resolves to nothing and the install is rejected. There is no
    spelling that would have reached across: the binding names an instance within
    the sibling set, so an out-of-set name is simply absent from it.
  '''

  packages: {
    host: {
      $liasse: 1
      $app: "t.mod.host@1.0.0"
      $model: {
        companies: {
          $key: "id"
          id: "text"
          name: "text"
          modules: {
            $key: "text"
            $value: "module"
            $interfaces: {
              people: { $view: { $key: "id", id: "text", name: "text" } }
              roster: { $view: { $key: "id", id: "text", name: "text" } }
            }
          }
        }
      }
      $data: {
        companies: {
          acme: { name: "Acme" }
          globex: { name: "Globex" }
        }
      }
    }
    people: {
      $liasse: 1
      $module: "t.people@1.0.0"
      $model: {
        members: { $key: "id", id: "text", name: "text" }
      }
      $expose: {
        people: { $view: ".members { id, name }" }
      }
    }
    sales: {
      $liasse: 1
      $module: "t.sales@1.0.0"
      $use: {
        people: "t.people/people@1"
      }
      $expose: {
        roster: { $view: "#people { id, name }" }
      }
    }
  }
  root: host

  steps: [
    { module_install: { at: "/companies/globex/modules"
        request: { $name: "peopleG", $module: "t.people@1.0.0"
                   $data: { members: { p1: { name: "Alice" } } } } }
      expect: { outcome: ok } }
    // The explicit binding names an instance of ANOTHER company's module
    // collection, so it is not in Acme's sibling set.
    { module_install: { at: "/companies/acme/modules"
        request: { $name: "sales", $module: "t.sales@1.0.0"
                   $use: { people: "peopleG" } } }
      expect: { outcome: rejected, violates: ["§13.5"]
                detail: "an explicit peer binding must name a sibling instance in the same module collection" } }
  ]
}
