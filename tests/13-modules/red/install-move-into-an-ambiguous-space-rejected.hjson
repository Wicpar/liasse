{
  format: 1
  name: install-move-into-an-ambiguous-space-rejected
  suite: scenario
  spec: ["#modules", "§13.16", "§13.2"]
  note: '''
    The attack is a package shaped so that ONE written destination names TWO
    declared module spaces. The root declares a top-level `modules` space and a
    row-scoped `companies.modules` space — both legal (§13.2: a space exists "at
    the location of each containing row", and a package may declare several) —
    and a ROW mutation of `companies` writes the bare `.modules[@name]` §13.16
    spells. Under the language's ordinary `.name` resolution that reads as either
    the package-root space (`/modules`) or the receiver row's
    (`/companies/acme/modules`), and nothing in the statement says which.

    Picking one is the worst available outcome. The call would report success,
    the instance would be mounted, every later read through the OTHER space would
    answer empty, and the operator would have a module installed somewhere they
    did not ask for — wrong module state, shipping as correct state. §13.2 makes
    the two spaces genuinely distinct ("Installing the same package in each space
    creates two independent instances"), so there is no reading under which a
    default is harmless.

    The transition must therefore be REFUSED, and the refusal must leave BOTH
    spaces untouched — the two reads after it are that check. The unambiguous
    spellings remain available: `/modules[@name]` for the package-root space and
    `.companies[@id].modules[@name]` for the row-scoped one.
  '''

  packages: {
    host: {
      $liasse: 1
      $app: "t.modinstall.ambiguous@1.0.0"
      $model: {
        modules: {
          $modules: {
            $interfaces: { items: { $view: { $key: "id", id: "text", qty: "int" } } }
          }
        }
        companies: {
          $key: "id"
          id: "text"
          modules: {
            $modules: {
              $interfaces: { items: { $view: { $key: "id", id: "text", qty: "int" } } }
            }
          }
          $mut: {
            // Both `/modules` and `/companies/<row>/modules` are declared, so
            // this bare destination names two spaces.
            "provision({ name: text, package: blob })": [
              ".modules[@name] <- unpack(@package)"
            ]
          }
        }
        $public: {
          root_items: { $view: '/modules["sales"]::items' }
          acme_items: { $view: '/companies["acme"].modules["sales"]::items' }
        }
      }
      $data: { companies: { acme: {} } }
    }
    sales: {
      $liasse: 1
      $module: "t.modinstall.ambiguous.sales@1.0.0"
      $model: {
        items: { $key: "id", id: "text", qty: "int" }
      }
      $data: { items: { a: { qty: "5" } } }
      $expose: { items: { $view: ".items { id, qty }" } }
    }
  }
  root: host

  steps: [
    { module_lifecycle_call: { mutation: "provision", package: "sales", receiver: ["acme"]
        args: { name: "sales" } }
      expect: { outcome: rejected, violates: ["§13.16", "§13.2"]
                detail: "the written destination names two declared `$modules` spaces and the statement does not say which; refused rather than installed into a guess" } }

    // Neither space was written to. A guess would have populated exactly one of
    // these, and reading only the other would have looked like a clean refusal.
    { watch: "public.root_items", id: "wr", expect_init: { value: [] } }
    { watch: "public.acme_items", id: "wa", expect_init: { value: [] } }
  ]
}
