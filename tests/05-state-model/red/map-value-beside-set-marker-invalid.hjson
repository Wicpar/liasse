{
  format: 1
  name: map-value-beside-set-marker-invalid
  suite: static
  spec: ["#state-model", "§5.3", "§5.4"]
  note: "§5.3/§5.4 and Annex C.2: `$value` composes only with `$key`. Beside a mutually-exclusive kind marker — here `$set` — the object has no uniquely determined node kind, which is the same static error a `$key`+`$set` conflict raises and must name both markers. No marker silently wins."

  package: {
    $liasse: 1
    $app: "t.mapconflict@1.0.0"
    $model: {
      settings: { $key: "text", $value: "text", $set: "text" }
    }
  }

  expect: { outcome: invalid, violates: ["§5.3", "§5.4"] }
}
